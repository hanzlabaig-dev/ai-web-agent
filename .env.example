# --- Provider selection -----------------------------------------------
# One of: gemini | openrouter | grok
LLM_PROVIDER=gemini

# Model name — meaning depends on provider:
#   gemini:     gemini-1.5-flash, gemini-2.0-flash-exp
#   openrouter: meta-llama/llama-3.1-8b-instruct:free  (see openrouter.ai/models?max_price=0)
#   grok:       grok-beta
MODEL=gemini-1.5-flash

# --- API keys (only set the one matching LLM_PROVIDER) -----------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROK_API_KEY=

# --- Target website (the ONLY domain the agent may contact) -----------
TARGET_BASE_URL=https://example.com

# --- Safety limits (optional overrides) --------------------------------
REQUEST_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=5000000
MAX_TOOL_CALLS_PER_TASK=100
MAX_POST_BODY_BYTES=5000000
MIN_SECONDS_BETWEEN_REQUESTS=0
LOG_FILE_PATH=logs/agent.log

# =========================================================================
# TOGGLE PANEL — on/off switches, current state shown in the CLI banner.
# =========================================================================
# ON  = every POST/PUT/PATCH/DELETE prints the request and waits for y/N.
# OFF = those fire immediately with no prompt (still domain-locked).
ENABLE_CONFIRMATION_PROMPT=false

# ON  = agent waits MIN_SECONDS_BETWEEN_REQUESTS between requests.
# OFF = no delay between requests.
ENABLE_RATE_LIMIT=false

# ON  = same-domain redirects are reported back, requiring a fresh tool call.
# OFF = same-domain redirects are followed automatically (up to AUTO_REDIRECT_MAX_HOPS).
ENABLE_REDIRECT_CONFIRMATION=false
AUTO_REDIRECT_MAX_HOPS=5

# Only matters when ENABLE_CONFIRMATION_PROMPT=true. Comma-separated path
# PREFIXES that skip the prompt anyway (e.g. /api/agent-test,/api/echo).
# "/" matches every path.
AUTO_APPROVE_POST_PATHS=/

# =========================================================================
# ALWAYS ON — not exposed as a setting, cannot be disabled from .env:
#   - single-domain lock (only TARGET_BASE_URL's exact host is reachable)
#   - private/loopback/link-local/reserved IP block (covers cloud metadata
#     endpoints like 169.254.169.254)
#   - file:// / javascript: / data: URL scheme block
#   - refusal of credential harvesting, auth bypass, and exploitation
# These are what make the domain lock hold under redirects and DNS tricks,
# so they stay hardcoded in security.py / agent.py regardless of anything
# set here.
# =========================================================================
